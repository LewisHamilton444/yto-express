# Copy this file to e2e/.env.e2e (git-ignored) and fill it in.
# Never put real values in this example file.

# Super admin login used by the map tests.
E2E_EMAIL=
E2E_PASSWORD=

# Leave both empty to test the live site. For local testing use:
#   E2E_BASE_URL=http://localhost:5173
#   E2E_API_URL=http://localhost:3001
E2E_BASE_URL=
E2E_API_URL=

# Optional: bridge key for the GPS route. Leave empty to use BRIDGE_API_KEY
# from server/.env. For the live site it must equal the key set on Render.
E2E_BRIDGE_API_KEY=

# Set to 1 to also run the slow (about 70 s) real stale-signal test.
E2E_SLOW=
