# Local development API endpoint
VITE_API_URL=http://localhost:3001

# Demo fixtures are OPT-IN since the G-13 fix (services/api.js): a production
# build with no flag is REAL-only, so fabricated rows can never be mistaken for
# real ones. Local UI work still wants populated tables, so demo mode is
# switched back on here — this file is loaded by `npm run dev` only, never by
# `vite build`. Set to 0 to see exactly what production would show.
VITE_DEMO_MODE=0
